<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Playwright para .NET (AGENTS.md: "Test runner ... Playwright para .NET (C#/xUnit) — E2E").
       Maneja un navegador real contra el frontend Angular (:8000) y la Api (:8080), ambos
       corriendo en vivo durante el test — ver Regla #0 de testing en el spec (Block 6). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Referencia a BingoCart.Infrastructure solo para el teardown: conectarse directamente a
       AppDbContext/SQL Server y borrar el ApplicationUser creado por cada test (Regla #0). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BingoCart.Infrastructure\BingoCart.Infrastructure.csproj" />
  </ItemGroup>

</Project>
