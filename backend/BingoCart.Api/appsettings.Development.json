{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,14330;Database=BingoCart;User Id=sa;Password=BingoCart_Dev2026!;TrustServerCertificate=True;Encrypt=True;"
  },
  "Tde": {
    // Password de la master key de TDE (corrective loop VERIFY→CODE de FEAT-001a) — credencial de
    // desarrollo local únicamente, igual que MSSQL_SA_PASSWORD, pero deliberadamente distinta de
    // esa: nunca la misma clave para dos secretos distintos. Sobreescribible con la variable de
    // entorno Tde__MasterKeyPassword (docker-compose.yml) si se necesita otra.
    "MasterKeyPassword": "BingoCart_TdeKey_2026#"
  },
  "Jwt": {
    // Clave de firma HMAC-SHA256 de desarrollo local únicamente — nunca un secreto real, nunca
    // usada fuera de este entorno. Sobreescribible con la variable de entorno Jwt__SigningKey
    // (docker-compose.yml), mismo criterio que ConnectionStrings__Default y
    // Tde__MasterKeyPassword. >=32 bytes UTF-8, exigido por la validación de JwtSettings (Block 1).
    "SigningKey": "-uBhxtdhOe3nsTJGPrTVZP1EL16zOGI0VYCVTbY8Zr57"
  },
  "Redis": {
    // Mismo puerto remapeado que docker-compose.yml (16379:6379, spec FEAT-008b Block 1) para no
    // chocar con un Redis local del desarrollador. Sobreescribible con la variable de entorno
    // Redis__ConnectionString dentro de docker-compose.yml (host `redis`, puerto interno 6379).
    "ConnectionString": "localhost:16379"
  },
  "Smtp": {
    // smtp4dev (spec FEAT-009b, Block 3) — servidor SMTP de prueba local, nunca reenvía a un
    // destinatario real (docker-compose.yml, puerto 2525 remapeado del 25 interno). Nunca un
    // secreto real, mismo criterio que Tde:MasterKeyPassword/Jwt:SigningKey. Sobreescribible con
    // las variables de entorno Smtp__Host/Smtp__Port/etc. si se necesita otro SMTP.
    "Host": "localhost",
    "Port": 2525,
    "User": "",
    "Password": "",
    "From": "no-reply@bingocart.local",
    // Únicamente porque smtp4dev usa un certificado autofirmado sin CA de confianza (ver
    // SmtpSettings.AllowInvalidCertificate) — SIEMPRE false en appsettings.json (Producción), R-08.
    "AllowInvalidCertificate": true
  }
}
